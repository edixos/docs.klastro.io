# Cloudflare Pages response headers, applied to every route.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  # Fully self-contained static site: Starlight's own scripts, styles and the
  # Pagefind search index. 'unsafe-inline' covers Starlight's inline theme
  # script (runs before first paint) and component styles. 'wasm-unsafe-eval'
  # is required by Pagefind's WebAssembly search.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Fingerprinted build assets are immutable.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
