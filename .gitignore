# build output
dist/
.astro/

# dependencies
node_modules/
# This project is npm-only: CI runs `npm ci` against package-lock.json. A stray
# pnpm lockfile (easy to create by habit in this monorepo, where every other
# JS submodule uses pnpm) would drift silently from the one CI installs from.
pnpm-lock.yaml
yarn.lock

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS
.DS_Store

# cloudflare / wrangler
.wrangler/

# agent operational state
.omc/
.claude/worktrees/
